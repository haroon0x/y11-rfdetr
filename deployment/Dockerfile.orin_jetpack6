# Dockerfile for Jetson Orin Nano (JetPack 6)
# Supports: GStreamer, Ultralytics, Pymavlink, OpenCV (built from source with GStreamer support)
# Compatibility: Ubuntu 22.04 + JetPack 6.x

# Use the official Ultralytics Jetson image for JetPack 6
FROM ultralytics/ultralytics:latest-jetson-jetpack6

# Set non-interactive installation and environment
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.local/bin:$PATH" \
    CMAKE_ARGS="-DWITH_GSTREAMER=ON" \
    ENABLE_CONTRIB=0 

# Install system dependencies (Optimized for Ubuntu 22.04)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-tools \
    gstreamer1.0-x \
    gstreamer1.0-alsa \
    gstreamer1.0-gl \
    gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 \
    gstreamer1.0-pulseaudio \
    curl git build-essential cmake pkg-config \
    python3-dev python3-pip python3-setuptools python3-wheel \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Step: Build OpenCV from source with GStreamer support (Cached heavy layer)
# This ensures that standard OpenCV is replaced with one that supports GStreamer pipelines.
RUN uv pip uninstall --system opencv-python opencv-contrib-python || true && \
    mkdir -p /tmp/opencv_build && cd /tmp/opencv_build && \
    git clone --recursive --depth 1 https://github.com/opencv/opencv-python.git && \
    cd opencv-python && \
    python3 -m pip wheel . --verbose && \
    python3 -m pip install opencv_python*.whl && \
    cd / && rm -rf /tmp/opencv_build

# Install other Python dependencies (Add any new libraries here)
RUN uv pip install --system \
    ultralytics \
    pymavlink \
    pyserial \
    numpy==1.23.5 \

# Set working directory
WORKDIR /app
